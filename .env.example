# .env — runtime config for KG-COST Neo4j load (Phase 9 / Session 10.5+).
# Copy to .env (gitignored) and edit. Defaults preserve the docker-compose
# stack (`kgcostlocal`) so omitting the file leaves Phase 9 behavior unchanged.

# Bolt connection (Python driver + cypher-shell)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=kgcostlocal
NEO4J_DATABASE=neo4j

# Import mode: docker | local-admin | bolt-apoc
#   docker      - run neo4j-admin inside the docker-compose container (default)
#   local-admin - run neo4j-admin from a Neo4j Desktop / standalone install
#   bolt-apoc   - load via bolt + apoc.load.csv (slower; for managed instances)
KG_COST_IMPORT_MODE=docker

# Path to the Neo4j install root (the directory containing bin/neo4j-admin).
# Required when KG_COST_IMPORT_MODE=local-admin. Example for Neo4j Desktop:
# KG_COST_NEO4J_HOME=<path-to-neo4j-dbms-directory>/dbms-<UUID>
KG_COST_NEO4J_HOME=

# Set to 1 to opt the live-Neo4j smoke test (tests/test_neo4j_smoke.py) into
# the pytest run. Otherwise the smoke tests skip.
KG_COST_RUN_NEO4J=0
